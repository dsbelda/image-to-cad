# Copia a .env (no se sube a git)

# --- IA ---
# anthropic                                       API de Anthropic
# openai | gemini | openrouter | mistral | groq | ollama
#                                                 cualquier API compatible con OpenAI (otro destino con AI_BASE_URL)
# claude_cli                                      CLI de Claude en una burbuja bwrap (solo Linux), sin API key
AI_PROVIDER=anthropic
AI_MODEL=                     # modelo con visión; obligatorio salvo con anthropic y claude_cli
AI_API_KEY=                   # clave del proveedor (ollama no la necesita)
AI_BASE_URL=                  # opcional: otro servidor compatible (LM Studio, vLLM, Azure…)
AI_EFFORT=medium              # esfuerzo del modo normal (anthropic y claude_cli)
AI_CONCURRENCY=2              # llamadas a la IA en paralelo como máximo
# CLAUDE_CODE_OAUTH_TOKEN=    # solo claude_cli en un servidor

# Modos de análisis (vacío = AI_MODEL, o el modelo grande de Anthropic)
AI_MODEL_EXHAUSTIVO=
AI_EFFORT_EXHAUSTIVO=medium
AI_MODEL_ULTRA=
AI_EFFORT_ULTRA=high

# Límites de análisis por modo (ventanas de 5 h y 24 h)
LIMIT_5H_NORMAL=15
LIMIT_5H_EXHAUSTIVO=4
LIMIT_5H_ULTRA=1
LIMIT_24H_NORMAL=40
LIMIT_24H_EXHAUSTIVO=10
LIMIT_24H_ULTRA=1

# --- Acceso (vacío = sin login, para uso local) ---
AUTH_USER=
AUTH_PASSWORD_HASH=           # python -c "from werkzeug.security import generate_password_hash as g; print(g('tu-clave'))"
SECRET_KEY=                   # fija las sesiones entre reinicios
COOKIE_SECURE=1               # pon 0 si usas login sobre http:// (sin HTTPS)

# --- Servidor y CAD ---
PORT=5055
ODA_PATH=                     # ruta de ODAFileConverter para exportar DWG (opcional)
